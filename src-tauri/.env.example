# ================================
# Pulsar Eventide Backend Config
# ================================

# [Fase 9] API Gateway Authentication
API_KEY=secret_pulsar_key

# [Fase 10] HNSW Sharding Configuration
SHARD_COUNT=4

# [Fase 11] Semantic Reranker (Cross-Encoder)
RERANKER_ENABLED=false

# [Fase 12] Semantic Cache Database
REDIS_URL=redis://127.0.0.1:6379
