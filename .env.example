# ============================================================
# Pulsaria — Variables de entorno de desarrollo
# ============================================================
# Copia este archivo como .env y ajusta los valores según tu entorno.
# Las variables marcadas con (requerido) son necesarias para el funcionamiento.
# Las demás son opcionales y tienen valores por defecto razonables.

# --- Base de datos y almacenamiento ---

# Directorio donde se almacenan la base de datos y los shards HNSW.
# En desarrollo: resolve a `data/` o `../data/` relativo al CWD.
# En Windows instalado: `%APPDATA%/Pulsaria`
# PULSAR_DATA_DIR=/ruta/a/tus/datos

# Directorio donde se guardan los videos procesados.
# Default: carpeta de Descargas del usuario.
# PULSAR_DOWNLOAD_DIR=/ruta/a/tus/videos

# --- Modelo de embeddings ---

# Ruta al modelo ONNX (all-MiniLM-L6-v2). Opcional, el sistema busca
# automáticamente en assets/models/ y resources/assets/models/.
# ONNX_MODEL_DIR=/ruta/al/modelo

# Número de shards HNSW para indexación vectorial paralela.
# Default: 4
# SHARD_COUNT=4

# --- Búsqueda semántica ---

# Habilitar el reranker cross-encoder (feature flag).
# Default: false (deshabilitado para mejorar latencia)
# RERANKER_ENABLED=false

# URL de Redis para caché semántica.
# Default: redis://127.0.0.1/
# REDIS_URL=redis://127.0.0.1/

# --- Modo distribuido ---

# Habilitar modo distribuido (experimental).
# Default: false
# DISTRIBUTED_MODE=false

# Nodos del cl separados por coma (modo distribuido).
# CLUSTER_NODES=node1:8080,node2:8080

# --- Cookies y autenticación ---

# Navegador del cual extraer cookies para descargas restringidas.
# Opciones válidas: chrome, edge, firefox
# Default: (ninguno — cookies deshabilitadas)
# PULSAR_COOKIES_FROM_BROWSER=chrome

# --- Seguridad (API REST) ---

# Secreto para JWT (solo si se usa autenticación en la API REST).
# Default: default_insecure_pulsar_secret (NO usar en producción)
# JWT_SECRET=tu-secreto-aqui

# Límite de requests por segundo en la API REST.
# Default: 10.0
# RATE_LIMIT_PER_SEC=10.0

# --- Políticas de retención ---

# Política de retención por defecto para videos procesados.
# keep = conservar archivos locales (default)
# online = eliminar archivos locales tras procesar (conservar solo ficha)
# PULSAR_DEFAULT_RETENTION=keep

# --- IA generativa local y Gemini opcional ---

# La IA local es el camino predeterminado y se descarga bajo demanda desde la
# revisión fijada en src-tauri/resources/local-llm-manifest.json.
# Gemini solo se puede invocar manualmente desde el shell nativo. La clave se
# lee desde el entorno del proceso, nunca desde el frontend ni desde SQLite.
# Configura como máximo una de estas variables fuera del repositorio:
# PULSAR_GOOGLE_API_KEY=tu-clave
# GOOGLE_API_KEY=tu-clave
# Nunca uses NEXT_PUBLIC_GOOGLE_API_KEY ni pongas una clave real en .env.example.
