{
    "name": "pulsaria",
    "version": "0.1.0-beta.3",
    "private": true,
    "scripts": {
        "dev": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev-next.ps1",
        "dev:tester": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev-tester.ps1",
        "sync:demo": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/sync-demo-media.ps1 -Clean",
        "reset:tester": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/reset-tester.ps1",
        "build:beta": "npm run sync:demo && npm run build",
        "build": "next build && node scripts/prepare-tauri-frontend.mjs",
        "start": "node server.js",
        "preview": "node server.js",
        "lint": "eslint .",
        "typecheck": "tsc --noEmit",
        "test:python": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-python-tests.ps1",
        "verify:mvp": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-mvp.ps1",
        "verify:api": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-api-loopback.ps1",
        "verify:frontend-secrets": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-frontend-secrets.ps1",
        "verify:legal-release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-legal-release.ps1",
        "verify:local-llm": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-local-llm.ps1",
        "verify:release-artifacts": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-release-artifacts.ps1",
        "verify:spdx": "node scripts/verify-spdx-license-expressions.mjs",
        "verify:installed": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-installed-bundle.ps1",
        "verify:versions": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-version-contract.ps1",
        "verify:canonical": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-canonical-structure.ps1",
        "verify:icons": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-icon-assets.ps1",
        "verify:onboarding": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-onboarding-contract.ps1",
        "verify-runtime-manifest.ps1": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-runtime-manifest.ps1",
        "verify:frontend-a11y": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-frontend-a11y-contract.ps1",
        "verify:website": "npm --prefix website run build",
        "prepare:runtime": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-runtime.ps1",
        "clean": "next clean",
        "tauri": "tauri"
    },
    "dependencies": {
        "@hookform/resolvers": "^5.2.1",
        "@number-flow/react": "^0.6.0",
        "@phosphor-icons/react": "^2.1.10",
        "@tauri-apps/plugin-updater": "2.11.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "focus-trap-react": "^12.0.3",
        "motion": "^12.43.0",
        "motion-dom": "^12.43.0",
        "motion-utils": "^12.39.0",
        "next": "16.3.8",
        "react": "^19.2.1",
        "react-dom": "^19.2.1",
        "sonner": "^2.0.7",
        "tailwind-merge": "^3.3.1",
        "three": "^0.183.2"
    },
    "devDependencies": {
        "@next/eslint-plugin-next": "16.3.8",
        "@tailwindcss/postcss": "4.1.11",
        "@tailwindcss/typography": "^0.5.19",
        "@tauri-apps/api": "2.10.1",
        "@tauri-apps/cli": "2.10.1",
        "@tauri-apps/plugin-shell": "2.3.5",
        "@types/node": "^20",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "@types/three": "0.183.1",
        "@typescript-eslint/parser": "8.70.0",
        "autoprefixer": "10.4.27",
        "eslint": "9.39.1",
        "eslint-config-next": "16.3.8",
        "eslint-plugin-import": "2.32.0",
        "eslint-plugin-jsx-a11y": "6.10.2",
        "eslint-plugin-react": "7.37.5",
        "eslint-plugin-react-hooks": "5.2.0",
        "fflate": "0.8.3",
        "firebase-tools": "^15.0.0",
        "globals": "14.0.0",
        "nanoid": "3.3.18",
        "postcss": "8.5.28",
        "sharp": "0.35.4",
        "spdx-expression-parse": "5.0.0",
        "tailwindcss": "4.1.11",
        "tw-animate-css": "^1.4.0",
        "typescript": "5.9.3"
    },
    "optionalDependencies": {
        "@next/swc-win32-x64-msvc": "16.3.8",
        "@tailwindcss/oxide-win32-x64-msvc": "^4.3.3",
        "lightningcss-win32-x64-msvc": "^1.33.0"
    },
    "overrides": {
        "qs": "6.16.0"
    }
}
